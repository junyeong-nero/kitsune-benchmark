{
  "schema_version": 1,
  "suite": "hostile-ui-v0",
  "status": "Draft capability matrix: no model calls. Every component reports success only from its own handler; the server records it.",
  "strategies": {
    "click": [{"tool": "browser_click", "args": {"target": "@primary"}}],
    "double_click": [{"tool": "browser_click", "args": {"target": "@primary", "doubleClick": true}}],
    "click_then_click": [{"tool": "browser_click", "args": {"target": "@trigger"}}, {"tool": "browser_click", "args": {"target": "@item"}}],
    "hover_then_click": [{"tool": "browser_hover", "args": {"target": "@trigger"}}, {"tool": "browser_click", "args": {"target": "@item"}}],
    "type": [{"tool": "browser_type", "args": {"target": "@field", "text": "$text"}}],
    "type_slowly": [{"tool": "browser_type", "args": {"target": "@field", "text": "$text", "slowly": true}}],
    "fill_form": [{"tool": "browser_fill_form", "args": {"fields": [{"target": "@field", "name": "$field_name", "type": "textbox", "value": "$text"}]}}],
    "click_then_keys": [{"tool": "browser_click", "args": {"target": "@field"}}, {"keys": "$text"}],
    "press_shortcut": [{"tool": "browser_press_key", "args": {"key": "$key"}}],
    "type_then_enter": [{"tool": "browser_type", "args": {"target": "@field", "text": "$text"}}, {"tool": "browser_press_key", "args": {"key": "Enter"}}],
    "type_then_click_option": [{"tool": "browser_type", "args": {"target": "@field", "text": "$text"}}, {"tool": "browser_click", "args": {"target": "@item"}}],
    "select_option": [{"tool": "browser_select_option", "args": {"target": "@field", "values": ["$text"]}}],
    "drag": [{"tool": "browser_drag", "args": {"startTarget": "@source", "endTarget": "@dest"}}],
    "slider_fill": [{"tool": "browser_fill_form", "args": {"fields": [{"target": "@field", "name": "$field_name", "type": "slider", "value": "$text"}]}}],
    "slider_keys": [{"tool": "browser_click", "args": {"target": "@field"}}, {"tool": "browser_press_key", "args": {"key": "PageUp"}, "repeat": 3}],
    "sortable_keys": [{"tool": "browser_click", "args": {"target": "@source"}}, {"tool": "browser_press_key", "args": {"key": " "}},
                      {"tool": "browser_press_key", "args": {"key": "ArrowUp"}, "repeat": 3}, {"tool": "browser_press_key", "args": {"key": " "}}],
    "trusted_click": [{"tool": "browser_trusted_click", "args": {"selector": "@primary"}}],
    "trusted_click_then_click": [{"tool": "browser_trusted_click", "args": {"selector": "@trigger", "restore_pointer": false}}, {"tool": "browser_click", "args": {"target": "@item"}}],
    "long_press": [{"tool": "browser_click", "args": {"target": "@primary", "hold_ms": 700}}],
    "hover_intent": [{"tool": "browser_hover", "args": {"target": "@trigger", "duration_ms": 500, "steps": 5}}, {"tool": "browser_click", "args": {"target": "@item"}}]
  },
  "kitsune_only": ["long_press", "hover_intent"],
  "components": [
    {"id": "trusted-click", "layer": "catalog", "mechanism": "Handler ignores events with isTrusted false",
     "targets": {"primary": {"role": ["button"], "name": "Confirm"}}, "strategies": ["click", "trusted_click"]},
    {"id": "pointer-sequence", "layer": "catalog", "mechanism": "Needs pointerdown + pointerup of one primary pointer released inside the element; ignores click",
     "targets": {"primary": {"role": ["button"], "name": "Start"}}, "strategies": ["click", "trusted_click"]},
    {"id": "hit-test", "layer": "catalog", "mechanism": "elementFromPoint(clientX, clientY) must be the button",
     "targets": {"primary": {"role": ["button"], "name": "Buy now"}}, "strategies": ["click", "trusted_click"]},
    {"id": "mousedown-menu", "layer": "catalog", "mechanism": "Menu opens on mousedown, item selected on mouseup",
     "targets": {"trigger": {"role": ["button"], "name": "Menu"}, "item": {"role": ["menuitem"], "name": "Rename"}},
     "strategies": ["click_then_click", "trusted_click_then_click"]},
    {"id": "css-hover-menu", "layer": "catalog", "mechanism": "Submenu shown only by CSS :hover of the real pointer",
     "targets": {"trigger": {"role": ["link"], "name": "Products"}, "item": {"role": ["link"], "name": "Pricing"}},
     "strategies": ["hover_then_click", "click_then_click", "hover_intent", "trusted_click_then_click"]},
    {"id": "hover-intent", "layer": "catalog", "mechanism": "Button appears after mousemove over the tile for 400 ms",
     "targets": {"trigger": {"role": ["group"], "name": "Preview tile"}, "item": {"role": ["button"], "name": "Open"}},
     "strategies": ["hover_then_click", "hover_intent", "trusted_click_then_click"]},
    {"id": "controlled-input", "layer": "catalog", "mechanism": "State changes only on input events; value written without one is reverted",
     "targets": {"field": {"role": ["textbox"], "name": "Display name"}}, "values": {"text": "Ada Lovelace", "field_name": "Display name"},
     "strategies": ["type", "type_slowly", "fill_form"]},
    {"id": "beforeinput-editor", "layer": "catalog", "mechanism": "contenteditable model changes only through beforeinput; DOM edits reverted",
     "targets": {"field": {"role": ["textbox"], "name": "Note"}}, "values": {"text": "kitsune test", "field_name": "Note"},
     "strategies": ["type", "type_slowly", "click_then_keys"]},
    {"id": "keyboard-shortcut", "layer": "catalog", "mechanism": "Shortcut handler tests KeyboardEvent.code",
     "targets": {}, "values": {"key": "Control+k"}, "strategies": ["press_shortcut"]},
    {"id": "keyup-search", "layer": "catalog", "mechanism": "Filters on keyup only",
     "targets": {"field": {"role": ["textbox"], "name": "Filter"}}, "values": {"text": "kit", "field_name": "Filter"},
     "strategies": ["type", "type_slowly", "fill_form"]},
    {"id": "pointer-capture-drag", "layer": "catalog", "mechanism": "Custom slider: pointerdown + setPointerCapture + pointermove, no keyboard",
     "targets": {"source": {"role": ["slider"], "name": "Brightness"}, "dest": {"role": ["img"], "name": "80% mark"},
                 "field": {"role": ["slider"], "name": "Brightness"}},
     "values": {"text": "80", "field_name": "Brightness"}, "strategies": ["drag", "slider_fill"]},
    {"id": "long-press", "layer": "catalog", "mechanism": "pointerdown held for 600 ms",
     "targets": {"primary": {"role": ["button"], "name": "Hold to delete"}}, "strategies": ["click", "long_press"]},
    {"id": "dblclick-only", "layer": "catalog", "mechanism": "Opens on dblclick only",
     "targets": {"primary": {"role": ["row", "cell", "button"], "name": "Report.pdf"}}, "strategies": ["double_click", "click"]},
    {"id": "user-activation", "layer": "catalog", "mechanism": "window.open needs transient user activation",
     "targets": {"primary": {"role": ["button"], "name": "Share"}}, "strategies": ["click", "trusted_click"]},
    {"id": "closed-shadow", "layer": "catalog", "mechanism": "Button inside a closed shadow root",
     "targets": {"primary": {"role": ["button"], "name": "Subscribe"}}, "strategies": ["click", "trusted_click"]},
    {"id": "cross-origin-iframe", "layer": "catalog", "mechanism": "Button in a cross-origin iframe",
     "targets": {"primary": {"role": ["button"], "name": "Pay"}}, "strategies": ["click", "trusted_click"]},
    {"id": "canvas-button", "layer": "catalog", "mechanism": "Canvas hit-testing at the centre; no DOM element for the button",
     "targets": {"primary": {"role": ["img"], "name": "Video player"}}, "strategies": ["click", "trusted_click"]},

    {"id": "lib-react-input", "layer": "library", "library": "react-dom 19.3.1", "mechanism": "React controlled input (onChange)",
     "targets": {"field": {"role": ["textbox"], "name": "Display name"}}, "values": {"text": "Ada Lovelace", "field_name": "Display name"},
     "strategies": ["type", "type_slowly", "fill_form"]},
    {"id": "lib-react-select", "layer": "library", "library": "react-select 5.10.2", "mechanism": "Searchable combobox on mousedown and keyboard",
     "targets": {"field": {"role": ["combobox"], "name": "Favorite fruit"}, "trigger": {"role": ["combobox"], "name": "Favorite fruit"},
                 "item": {"role": ["option"], "name": "Mango"}},
     "values": {"text": "Mango", "field_name": "Favorite fruit"}, "strategies": ["click_then_click", "type_then_enter", "type_then_click_option", "select_option"]},
    {"id": "lib-radix-dropdown", "layer": "library", "library": "@radix-ui/react-dropdown-menu 2.2.1", "mechanism": "Trigger opens on pointerdown, items select on pointerup/click",
     "targets": {"trigger": {"role": ["button"], "name": "Options"}, "item": {"role": ["menuitem"], "name": "Archive"}},
     "strategies": ["click_then_click", "hover_then_click", "trusted_click_then_click"]},
    {"id": "lib-radix-select", "layer": "library", "library": "@radix-ui/react-select 2.4.1", "mechanism": "Custom listbox, pointer selection and typeahead",
     "targets": {"trigger": {"role": ["combobox"], "name": "Theme"}, "field": {"role": ["combobox"], "name": "Theme"},
                 "item": {"role": ["option"], "name": "Dark"}},
     "values": {"text": "Dark"}, "strategies": ["click_then_click", "select_option", "trusted_click_then_click"]},
    {"id": "lib-radix-slider", "layer": "library", "library": "@radix-ui/react-slider 1.6.1", "mechanism": "Pointer capture on the track, arrow/page keys on the thumb",
     "targets": {"field": {"role": ["slider"], "name": "Volume"}}, "values": {"text": "80", "field_name": "Volume"},
     "strategies": ["slider_fill", "slider_keys"]},
    {"id": "lib-dndkit-sortable", "layer": "library", "library": "@dnd-kit/sortable 10.0.0", "mechanism": "Pointer sensor with 5 px activation, keyboard sensor",
     "targets": {"source": {"role": ["button"], "name": "Drag Delta"}, "dest": {"role": ["button"], "name": "Drag Alpha"}},
     "strategies": ["drag", "sortable_keys"]},
    {"id": "lib-tiptap", "layer": "library", "library": "@tiptap/react 3.32.1 (ProseMirror)", "mechanism": "Editor state through beforeinput/keydown",
     "targets": {"field": {"role": ["textbox"], "name": "Note"}}, "values": {"text": "kitsune test", "field_name": "Note"},
     "strategies": ["type", "type_slowly", "click_then_keys"]},
    {"id": "lib-codemirror", "layer": "library", "library": "codemirror 6.0.2", "mechanism": "Editor state through its own input handling",
     "targets": {"field": {"role": ["textbox"], "name": "Code"}}, "values": {"text": "const answer = 42", "field_name": "Code"},
     "strategies": ["type", "type_slowly", "click_then_keys"]},
    {"id": "lib-daypicker", "layer": "library", "library": "react-day-picker 10.0.2", "mechanism": "Calendar grid with its own focus model",
     "targets": {"primary": {"role": ["button", "gridcell"], "name": "November 18"}}, "strategies": ["click", "trusted_click"]}
  ]
}
